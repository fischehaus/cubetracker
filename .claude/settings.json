{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Cubetracker-projekt-spezifische Claude-Code-Settings. Hooks gegen die wiederkehrenden Mental-Model-Fehler + Klassiker-Bugs aus der Projekt-Historie: (1) lokale Dev-Server statt Render-Deploy, (2) Commits vergessen zu pushen, (3) Patch-Notes ohne Git-Tag, (4) hartkodiertes localhost in Frontend (v1.0.1-Bug), (5) Session-Start ohne Repo-Context (heutiger Mental-Model-Drift).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start-context.sh\"",
            "timeout": 10,
            "shell": "bash"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-bash-dev-server.sh\"",
            "timeout": 5,
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-git-commit.sh\"",
            "timeout": 10,
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-hardcoded-url.sh\"",
            "timeout": 5,
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
